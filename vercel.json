{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/projector.html", "destination": "/public/projector.html" },
    { "source": "/stage.html", "destination": "/public/stage.html" },
    { "source": "/remote.html", "destination": "/public/remote.html" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ]
}
